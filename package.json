{
	"name": "campus-api",
	"version": "1.0.0",
	"description": "REST API for a student dashboard — authentication, students, courses, and assignments. Node.js, Express, TypeScript, PostgreSQL, Prisma.",
	"main": "dist/server.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "tsx watch --clear-screen=false server.ts",
		"build": "tsc",
		"build:watch": "tsc --watch",
		"start": "node dist/server.js",
		"type-check": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mjs}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mjs}\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [
		"api",
		"backend",
		"rest-api",
		"express",
		"typescript",
		"prisma",
		"postgresql",
		"jwt",
		"zod"
	],
	"author": {
		"name": "Mohamed Fathy",
		"email": "mofathy1833@gmail.com",
		"url": "https://github.com/Mofathy183"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Mofathy183/campus-api.git"
	},
	"engines": {
		"node": ">=20.6.0"
	},
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-xss-sanitizer": "^2.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.2.0",
		"@types/supertest": "^7.2.1",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.6",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.6",
		"supertest": "^7.2.2",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@types/pg": "^8.21.0",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.2",
		"express-xss-sanitizer": "^2.0.2",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"prisma": "^7.9.1",
		"zod": "^4.4.3"
	}
}
