# ============================================================================
# campus-api — Environment Variables
# Copy this file to .env and fill in real values. .env is gitignored —
# never commit actual secrets. See README.md "Environment Variables" for
# a description of each var and where it's consumed.
# ============================================================================

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/campus_api?schema=public"

# ------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------
# Generate a real value with: openssl rand -base64 48
JWT_ACCESS_TOKEN_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_ACCESS_TOKEN_EXPIRES_IN=1d
JWT_ISSUER=campus-api
JWT_AUDIENCE=campus-api-client

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# Comma-separated list of allowed origins, or "*" for local dev.
CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info