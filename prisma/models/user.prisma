/// Authentication identity. Each `User` holds exactly one email +
/// password hash and backs `POST /login`; domain-specific profile
/// data lives on the related `Student` model instead.
model User {
    id String @id @default(uuid())

    email          String @unique @db.VarChar(255)
    hashedPassword String @map("hashed_password")

    role UserRole @default(STUDENT)

    /// Nullable 1:1 — an ADMIN user has no Student profile. Enforced
    /// at the service layer, not the database.
    student Student?

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("users")
}

enum UserRole {
    ADMIN
    STUDENT
}
