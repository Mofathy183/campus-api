/// An assignment owned by exactly one `Student`.
///
/// Backs: GET /assignments, POST /assignments, PATCH /assignments/:id
model Assignment {
    id String @id @default(uuid())

    title       String  @db.VarChar(150)
    description String? @db.Text

    studentId String @map("student_id")
    student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    status AssignmentStatus @default(PENDING)

    dueAt DateTime? @map("due_at")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    /// Every list query filters by student — index accordingly.
    @@index([studentId])
    @@map("assignments")
}

/// `PATCH /assignments/:id` mutates this field to move an assignment
/// through its lifecycle.
enum AssignmentStatus {
    PENDING
    SUBMITTED
    GRADED
    LATE
}
