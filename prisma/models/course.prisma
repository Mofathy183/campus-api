/// A standalone course resource, with no relation to `Student` or
/// `Assignment` — courses and enrollment are tracked independently
/// of assignment records.
///
/// Backs: GET /courses, GET /courses/:id, POST /courses
model Course {
    id String @id @default(uuid())

    code  String @unique @db.VarChar(20) // e.g. "CS201"
    title String @db.VarChar(150)

    description String? @db.Text

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("courses")
}
