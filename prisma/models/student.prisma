/// Student profile data, split from User the same way Beggy splits
/// Profile from User — auth concerns don't live next to domain data.
///
/// Backs: GET /students, GET /students/:id, POST /students,
///        PUT /students/:id, DELETE /students/:id
model Student {
    id String @id @default(uuid())

    userId String @unique @map("user_id")
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    firstName String @map("first_name") @db.VarChar(50)
    lastName  String @map("last_name") @db.VarChar(50)

    /// Institution-facing identifier. Not explicitly asked for by the
    /// spec — flagged as an assumption in THINKING.md Q1. Keeps
    /// GET /students from returning bare UUIDs in a demo.
    studentCode String @unique @map("student_code") @db.VarChar(20)

    assignments Assignment[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("students")
}
