/// A student's profile data, kept separate from `User` so
/// authentication concerns don't live alongside domain data.
///
/// Backs: GET /students, GET /students/:id, POST /students,
///        PUT /students/:id, DELETE /students/:id
model Student {
    id String @id @default(uuid())

    userId String @unique @map("user_id")
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    firstName String @map("first_name") @db.VarChar(50)
    lastName  String @map("last_name") @db.VarChar(50)

    /// Institution-facing identifier, distinct from the internal UUID
    /// — keeps list/detail responses from surfacing bare UUIDs.
    studentCode String @unique @map("student_code") @db.VarChar(20)

    assignments Assignment[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("students")
}
